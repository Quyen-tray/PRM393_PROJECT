DB_URL=jdbc:sqlserver://localhost:1433;databaseName=HRM_CoffeeShop;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Web Client ID (+ iOS nếu cần), ngăn cách bằng dấu phẩy. Cách lấy: docs/GOOGLE_LOGIN.md
GOOGLE_CLIENT_ID=
STORAGE_SIGNING_SECRET=change-me
STORAGE_LOCAL_DIR=./data/storage

# CHỈ ĐỂ TEST khi chưa làm Google login (ngoài SRS). Production: để false/bỏ trống.
DEV_PASSWORD_LOGIN_ENABLED=false
# Chỉ có tác dụng khi DEV_PASSWORD_LOGIN_ENABLED=true; chỉ đặt cho tài khoản chưa có mật khẩu, không ghi đè.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
TEST_ACCOUNTS_PASSWORD=
